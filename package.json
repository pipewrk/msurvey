    "visualize": "meteor --production --extra-packages bundle-visualizer",
    "format": "eslint --fix ."
  },
  "dependencies": {
    "@babel/runtime": "^7.0.0",
    "@react-navigation/core": "^3.7.9",
    "@react-navigation/web": "^1.0.0-alpha.7",
    "d3-array": "^1.2.4",
    "d3-format": "^1.3.2",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-shape": "^1.2.2",
    "date-fns": "^1.29.0",
    "debounce": "^1.2.0",
    "meteor-node-stubs": "^1.2.24",
    "ramda": "^0.25.0",
    "rc-tween-one": "^2.2.14",
    "react": "^16.5.0",
    "react-dom": "^16.5.0",
    "react-redux": "^5.1.0",
    "redux": "^4.0.1"
  },
  "devDependencies": {
    "autoprefixer": "^9.3.1",
    "babel-eslint": "^10.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-babel": "^5.2.1",
    "eslint-plugin-flowtype": "^2.50.0",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-meteor": "^5.1.0",
    "eslint-plugin-react": "^7.11.1",
    "expect": "^30.2.0",
    "postcss": "^6.0.22",
    "postcss-load-config": "^6.0.1"
